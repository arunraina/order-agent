ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — protects the external /api/v1/* surface. If unset, the server
# logs a dev fallback key at startup (fine locally, not for a public deploy).
ORDER_AGENT_API_KEY=

# Required for persistence (orders/order_lines/decisions) — Settings > API
# in your Supabase project. Use the service_role secret key, not the anon
# key: this server is a trusted backend, and service_role is what lets it
# write regardless of the order_agent schema's RLS policies (there are none
# for anon/authenticated — see the order_agent_schema migration).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
